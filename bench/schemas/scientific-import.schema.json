{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-bench.local/schemas/scientific-import.schema.json",
  "title": "Scientific regression-suite import recipe",
  "type": "object",
  "required": ["source", "cases"],
  "properties": {
    "source": {
      "enum": [
        "quantum-espresso-test-suite",
        "openmc-tests",
        "su2-testcases",
        "energyplus-tests",
        "modflow6-tests"
      ]
    },
    "upstream_revision": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["id", "case_path", "problem_statement"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "case_path": {"type": "string", "minLength": 1},
        "problem_statement": {"type": "string", "minLength": 1},
        "workspace_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/asset"}
        },
        "evaluator_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/asset"}
        },
        "recipe_evaluator_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/asset"}
        },
        "checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "test_commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        },
        "validation": {
          "type": "object",
          "properties": {
            "required_paths": {"type": "array", "items": {"type": "string"}},
            "forbidden_paths": {"type": "array", "items": {"type": "string"}},
            "content_assertions": {"type": "array", "items": {"type": "object"}},
            "metrics": {"type": "array", "items": {"type": "object"}}
          },
          "additionalProperties": false
        },
        "workstreams": {"type": "array", "items": {"type": "object"}},
        "environment": {"type": "object"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
