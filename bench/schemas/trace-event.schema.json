{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-bench.local/schemas/trace-event.schema.json",
  "title": "Normalized trace event",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "elapsed_seconds", "event_type", "actor", "payload", "input_tokens", "output_tokens", "tool_calls"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "event_type": {"enum": ["run_started", "phase_started", "agent_started", "model_response", "tool_called", "tool_result", "message", "agent_finished", "phase_finished", "run_finished"]},
    "actor": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0}
  }
}
