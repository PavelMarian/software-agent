{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-bench.local/schemas/evaluation.schema.json",
  "title": "Hidden TaskBundle evaluation specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["test_commands"],
  "properties": {
    "strategy": {"enum": ["swe_patch", "command_checks"]},
    "submission_kind": {
      "enum": ["patch", "artifact_bundle", "environment_state", "workspace_files"]
    },
    "test_patch": {"type": "string"},
    "FAIL_TO_PASS": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "PASS_TO_PASS": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "test_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "parser"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "parser": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "shell": {"type": "boolean"}
        }
      }
    },
    "additional_oracles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "layer": {"enum": ["integration", "system", "performance"]},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "required": {"type": "boolean"},
          "weight": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "weight": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "submission_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "submission_root": {"type": ["string", "null"], "minLength": 1},
    "state_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evaluator_assets": {"type": ["string", "null"]},
    "backend_hint": {"type": ["string", "null"], "minLength": 1}
  }
}
