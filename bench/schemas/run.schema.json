{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-bench.local/schemas/run.schema.json",
  "title": "Normalized benchmark run",
  "type": "object",
  "required": ["schema_version", "run_id", "instance_id", "mode", "agent_topology", "agent_runtime", "adapter_id", "adapter_contract", "environment_backend", "seed", "status", "measurement_complete", "phase_count", "agent_run_count", "partial_submission", "partial_submission_reason", "patch_size_bytes", "submission_kind", "submission_file_count", "submission_size_bytes", "budget", "usage", "roles"],
  "properties": {
    "schema_version": {"const": "0.5.0"},
    "run_id": {"type": "string", "minLength": 1},
    "instance_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["unrestricted_solo", "compute_matched_solo", "independent_ensemble", "full_mas", "mas_no_planner", "mas_no_verifier"]},
    "agent_topology": {"enum": ["single_agent", "multi_agent", "independent_ensemble"]},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_contract": {"enum": ["model", "framework"]},
    "environment_backend": {"type": "string", "minLength": 1},
    "agent_runtime": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "seed": {"type": "integer"},
    "status": {"type": "string"},
    "stop_reason": {"type": "string"},
    "partial_submission": {"type": "boolean"},
    "partial_submission_reason": {"type": "string"},
    "measurement_complete": {"type": "boolean"},
    "phase_count": {"type": "integer", "minimum": 0},
    "agent_run_count": {"type": "integer", "minimum": 0},
    "patch_size_bytes": {"type": "integer", "minimum": 0},
    "submission_kind": {
      "enum": ["patch", "artifact_bundle", "environment_state", "workspace_files"]
    },
    "submission_file_count": {"type": "integer", "minimum": 0},
    "evidence_file_count": {"type": "integer", "minimum": 0},
    "stage_artifact_count": {"type": "integer", "minimum": 0},
    "submission_size_bytes": {"type": "integer", "minimum": 0},
    "budget_policy": {"enum": ["team_total", "run_ceiling"]},
    "fair_comparison_group": {"type": ["string", "null"]},
    "budget": {"$ref": "#/$defs/budget"},
    "usage": {"$ref": "#/$defs/usage"},
    "roles": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "trace_metrics": {"$ref": "#/$defs/trace_metrics"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "budget": {
      "type": "object",
      "required": ["token_limit", "wall_time_seconds", "tool_call_limit"],
      "properties": {
        "token_limit": {"type": "integer", "minimum": 1},
        "wall_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "tool_call_limit": {"type": "integer", "minimum": 1}
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens", "tool_calls", "wall_time_seconds"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "wall_time_seconds": {"type": "number", "minimum": 0}
      }
    },
    "trace_metrics": {
      "type": "object",
      "required": ["communication", "coordination", "active_role_count", "per_role", "tools"],
      "properties": {
        "communication": {
          "type": "object",
          "required": ["message_count"],
          "properties": {
            "message_count": {"type": "integer", "minimum": 0}
          }
        },
        "coordination": {"$ref": "#/$defs/coordination"},
        "active_role_count": {"type": "integer", "minimum": 0},
        "per_role": {"type": "object"},
        "tools": {"type": "object"}
      }
    },
    "coordination": {
      "type": "object",
      "required": [
        "messages_sent",
        "messages_received",
        "unique_messages_delivered",
        "message_delivery_rate",
        "unique_handoff_edge_count",
        "handoff_edges",
        "participating_role_count",
        "role_coverage",
        "receipt_batch_count",
        "handoff_followed_by_action_count",
        "handoff_action_rate",
        "cross_role_tool_transition_count",
        "cross_role_artifact_reuse_count",
        "redundant_cross_role_call_count"
      ],
      "properties": {
        "messages_sent": {"type": "integer", "minimum": 0},
        "messages_received": {"type": "integer", "minimum": 0},
        "unique_messages_delivered": {"type": "integer", "minimum": 0},
        "message_delivery_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "unique_handoff_edge_count": {"type": "integer", "minimum": 0},
        "handoff_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1}
            }
          }
        },
        "participating_role_count": {"type": "integer", "minimum": 0},
        "role_coverage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "receipt_batch_count": {"type": "integer", "minimum": 0},
        "handoff_followed_by_action_count": {"type": "integer", "minimum": 0},
        "handoff_action_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "cross_role_tool_transition_count": {"type": "integer", "minimum": 0},
        "cross_role_artifact_reuse_count": {"type": "integer", "minimum": 0},
        "redundant_cross_role_call_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
