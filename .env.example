# Copy this file to .env and fill in the key for the selected provider.
# Never commit .env. Command-line --provider/--model values override these defaults.
SOFTWARE_MULTIAGENT_PROVIDER=openrouter
SOFTWARE_MULTIAGENT_MODEL=

OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Embeddings may use the same OpenRouter key, but remain separately configurable.
SOFTWARE_MEMORY_EMBEDDING_API_KEY=
SOFTWARE_MEMORY_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
SOFTWARE_MEMORY_EMBEDDING_MODEL=
SOFTWARE_MEMORY_EMBEDDING_PROVIDER=openrouter

# Optional persistent bidirectional memory. Leave DATABASE empty to disable it.
SOFTWARE_MEMORY_DATABASE=
# Optional derived semantic index. It supplements SQLite results and never replaces them.
SOFTWARE_MEMORY_VECTOR_DATABASE=
SOFTWARE_MEMORY_SOFTWARE_ID=
SOFTWARE_MEMORY_SOFTWARE_VERSION=
