{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-multiagent.local/schemas/tool-generation-recipe.schema.json",
  "title": "Application tool generation recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["application", "tools"],
  "properties": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "required_executables": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "source",
        "input_schema"
      ],
      "oneOf": [
        {"required": ["command"], "not": {"required": ["wrapper"]}},
        {"required": ["wrapper"], "not": {"required": ["command"]}}
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
        "description": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "evidence": {"type": "string"},
        "input_schema": {"type": "object"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "wrapper": {"$ref": "#/$defs/wrapper"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 1800},
        "mutating": {"type": "boolean"},
        "sample_arguments": {"type": ["object", "null"]},
        "expected": {"$ref": "#/$defs/expected"}
      }
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["python", "http", "pipeline"]},
        "module": {"type": "string", "minLength": 1},
        "callable": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": {"type": "integer"},
        "stdout_contains": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "stderr_contains": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "created_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "stdout_json": {"type": "boolean"}
      }
    }
  }
}
