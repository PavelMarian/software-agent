# Mirrors the upstream FoamBench OpenFOAM 10 base; pin the resolved digest in experiment metadata.
FROM openfoam/openfoam10-paraview510:latest
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    git openssh-client python3 python3-pip unzip \
    openmpi-bin libopenmpi-dev && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir pandas pyvista rouge-score pyyaml
WORKDIR /work
USER foam
